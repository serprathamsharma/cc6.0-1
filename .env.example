# ============================
# ScoutIQ — Environment Config
# Copy to .env and fill values
# ============================

# --- App ---
APP_SECRET_KEY=changeme-32-char-secret-key-here
DEMO_MODE=false          # set true to force fixture replay
REPLAY_MODE=false        # set true in CI

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scoutiq
POSTGRES_USER=scoutiq
POSTGRES_PASSWORD=scoutiq_dev_pass
DATABASE_URL=postgresql+asyncpg://scoutiq:scoutiq_dev_pass@postgres:5432/scoutiq
DATABASE_URL_SYNC=postgresql://scoutiq:scoutiq_dev_pass@postgres:5432/scoutiq

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- AI Models (OpenAI) ---
OPENAI_API_KEY=
MODEL_PLANNER=gpt-4o          # maps to gpt-6-astra when available
MODEL_EXTRACT=gpt-4o          # maps to gpt-6-sol when available
MODEL_FAST=gpt-4o-mini        # maps to gpt-6-luna when available
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMS=1536
LLM_PRICING_FILE=              # optional override path

# --- Search Providers ---
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Snapshot Storage ---
SNAPSHOT_BACKEND=local         # local | s3
SNAPSHOT_LOCAL_DIR=/data/snapshots
# S3 (only when SNAPSHOT_BACKEND=s3)
SNAPSHOT_S3_BUCKET=
SNAPSHOT_S3_ENDPOINT=
SNAPSHOT_S3_ACCESS_KEY=
SNAPSHOT_S3_SECRET_KEY=

# --- Rate Limits ---
RATE_LIMIT_DEFAULT_RPS=1       # requests/sec per domain default
# RATE_LIMIT_RULES={"linkedin.com": 0.1, "github.com": 2}

# --- Frontend (build-time) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
